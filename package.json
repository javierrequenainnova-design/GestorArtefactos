{
  "name": "gestor-artefactos-desktop",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para gestionar artefactos, su biblioteca y un lienzo de relaciones",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.gestorartefactos",
    "productName": "Gestor de Artefactos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"]
    },
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
